{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended", "helpers:pinGitHubActionDigests"],
  "schedule": ["before 6am on monday"],
  "minimumReleaseAge": "3 days",
  "postUpdateOptions": ["gomodTidy"],
  "customManagers": [
    {
      "customType": "regex",
      "description": "Tool versions marked with a renovate comment, in the CI setup action and the Dockerfile.",
      "managerFilePatterns": ["/^\\.github/actions/.+\\.ya?ml$/", "/^Dockerfile$/"],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>\\S+) depName=(?<depName>\\S+)\\n.*?(?<currentValue>\\d+\\.\\d+\\.\\d+)"
      ],
      "extractVersionTemplate": "^v?(?<version>.*)$"
    }
  ],
  "argocd": {
    "managerFilePatterns": ["/^deploy/argocd/.+\\.ya?ml$/"]
  },
  "packageRules": [
    {
      "matchManagers": ["gomod"],
      "groupName": "Go modules"
    },
    {
      "matchManagers": ["gomod"],
      "matchFileNames": ["backend/tools/go.mod", "deploy/go.mod"],
      "groupName": "Go tools"
    },
    {
      "matchManagers": ["npm"],
      "matchDepTypes": ["dependencies"],
      "groupName": "npm dependencies"
    },
    {
      "matchManagers": ["npm"],
      "matchDepTypes": ["devDependencies"],
      "groupName": "npm dev dependencies"
    },
    {
      "matchManagers": ["dockerfile", "docker-compose"],
      "groupName": "Docker images"
    },
    {
      "matchManagers": ["github-actions", "custom.regex"],
      "groupName": "GitHub Actions"
    },
    {
      "matchManagers": ["argocd"],
      "groupName": "Helm charts"
    },
    {
      "description": "The Playwright image must match @playwright/test.",
      "matchPackageNames": ["@playwright/test", "mcr.microsoft.com/playwright"],
      "groupName": "Playwright"
    },
    {
      "matchDepTypes": ["devDependencies"],
      "matchUpdateTypes": ["minor", "patch"],
      "automerge": true
    },
    {
      "matchManagers": ["gomod"],
      "matchFileNames": ["backend/tools/go.mod", "deploy/go.mod"],
      "matchUpdateTypes": ["minor", "patch"],
      "automerge": true
    },
    {
      "matchPackageNames": ["@playwright/test", "mcr.microsoft.com/playwright"],
      "matchUpdateTypes": ["minor", "patch"],
      "automerge": true
    },
    {
      "matchManagers": ["github-actions", "custom.regex"],
      "matchUpdateTypes": ["minor", "patch", "digest", "pin", "pinDigest"],
      "automerge": true
    },
    {
      "description": "One PR for packageManager and the Dockerfile, so the image builds with the same pnpm.",
      "matchPackageNames": ["pnpm"],
      "groupName": "pnpm",
      "automerge": false
    },
    {
      "matchPackageNames": ["pnpm"],
      "matchUpdateTypes": ["minor", "patch"],
      "automerge": true
    }
  ]
}
